---
import BaseLayout from '../layouts/BaseLayout.astro';
import LensingField from '../components/LensingField.astro';
import { site } from '../data/site';
import { academic, independent } from '../data/projects';

const selected = [...academic, ...independent];
---

<BaseLayout>
  <section class="hero container">
    <div class="hero-text">
      <p class="label reveal">Physicist &nbsp;·&nbsp; Researcher &nbsp;·&nbsp; {site.location}</p>
      <h1 class="reveal reveal-2">
        Physicist by training,<br />
        <em>problem solver</em> at heart.
      </h1>
      <p class="lede reveal reveal-3">
        I'm Jeimin Garibnavajwala. My background is in cosmology and weak gravitational lensing. This is where I
        share my projects, my thoughts, and other things I've been working on.
      </p>

      <div class="actions reveal reveal-4">
        <a href="/about" class="btn btn--solid">About me <span class="arrow" aria-hidden="true">→</span></a>
        <a href="/projects" class="btn">View projects</a>
      </div>

      <ul class="social reveal reveal-4">
        <li>
          <a href={site.social.github} target="_blank" rel="noopener" aria-label="GitHub">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
              <path
                d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.11 3.04.74.8 1.19 1.83 1.19 3.08 0 4.41-2.69 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"
              ></path>
            </svg>
            <span>GitHub</span>
          </a>
        </li>
        <li>
          <a href={site.social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
              <path
                d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"
              ></path>
            </svg>
            <span>LinkedIn</span>
          </a>
        </li>
        <li>
          <a href={site.cv} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M14 3H6.5A1.5 1.5 0 0 0 5 4.5v15A1.5 1.5 0 0 0 6.5 21h11a1.5 1.5 0 0 0 1.5-1.5V8l-5-5Z"></path>
              <path d="M14 3v5h5M8.5 13h7M8.5 16.5h5"></path>
            </svg>
            <span>Curriculum Vitae</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="hero-art reveal reveal-3" aria-hidden="false">
      <LensingField />
    </div>
  </section>

  <section class="quote container" aria-label="Quote">
    <blockquote>
      <p>“Deep mind, deep ocean, and deep space are three frontiers of modern science.”</p>
    </blockquote>
  </section>

  <section class="selected container" aria-labelledby="selected-title">
    <div class="section-head">
      <h2 id="selected-title">Selected work</h2>
      <a href="/projects" class="text-link">All projects <span class="arrow" aria-hidden="true">→</span></a>
    </div>

    <ol class="work-list">
      {
        selected.map((p, i) => (
          <li>
            <a
              href={p.href}
              target={p.external ? '_blank' : undefined}
              rel={p.external ? 'noopener' : undefined}
            >
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <span class="body">
                <span class="title">{p.title}</span>
                <span class="summary">{p.summary}</span>
              </span>
              <span class="meta label">{p.period}</span>
              <span class="go" aria-hidden="true">{p.external ? '↗' : '→'}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.6fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
    padding-top: clamp(3.5rem, 10vw, 8rem);
  }

  .hero h1 {
    margin-top: 1.5rem;
    font-size: clamp(2.5rem, 1.3rem + 4.2vw, 4.25rem);
    font-weight: 330;
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .hero h1 em {
    color: var(--accent);
    font-weight: 300;
  }

  .lede {
    margin: 2rem 0 0;
    max-width: 46ch;
    font-size: clamp(1.15rem, 1rem + 0.45vw, 1.35rem);
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  .social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    list-style: none;
    padding: 0;
    margin: 2.25rem 0 0;
  }

  .social a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--ink-soft);
    text-decoration: none;
  }

  .social a:hover {
    color: var(--accent);
  }

  .hero-art {
    max-width: 440px;
    justify-self: end;
    width: 100%;
  }

  /* Quote */
  .quote {
    margin-top: clamp(5rem, 12vw, 9rem);
  }

  .quote blockquote {
    margin: 0 auto;
    max-width: 30ch;
    text-align: center;
    position: relative;
    padding-top: 2.5rem;
  }

  .quote blockquote::before {
    content: '✦';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    color: var(--ornament);
    font-size: 0.8rem;
  }

  .quote p {
    margin: 0;
    font-size: clamp(1.6rem, 1.1rem + 2vw, 2.5rem);
    font-style: italic;
    font-weight: 300;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  /* Selected work */
  .selected {
    margin-top: clamp(5rem, 12vw, 9rem);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--ink);
  }

  .section-head h2 {
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem);
    font-weight: 350;
  }

  .work-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .work-list li {
    border-bottom: 1px solid var(--rule);
  }

  .work-list a {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto 1.5rem;
    align-items: baseline;
    gap: 1.25rem;
    padding: 1.6rem 0;
    text-decoration: none;
    transition: padding 0.35s var(--ease), background-color 0.35s var(--ease);
  }

  .work-list a:hover {
    color: inherit;
    padding-left: 0.75rem;
    padding-right: 0.75rem;
    background: var(--accent-soft);
  }

  .num {
    font-family: var(--sans);
    font-size: 0.75rem;
    color: var(--ornament);
    font-variant-numeric: tabular-nums;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .title {
    font-size: clamp(1.35rem, 1.1rem + 0.9vw, 1.75rem);
    line-height: 1.2;
  }

  .work-list a:hover .title {
    color: var(--accent);
  }

  .summary {
    color: var(--ink-soft);
    font-size: 1rem;
  }

  .go {
    color: var(--ink-faint);
    transition: transform 0.35s var(--ease), color 0.35s var(--ease);
  }

  .work-list a:hover .go {
    color: var(--accent);
    transform: translateX(4px);
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero-art {
      order: -1;
      max-width: 240px;
      justify-self: start;
      margin-bottom: -1rem;
    }
  }

  @media (max-width: 640px) {
    .work-list a {
      grid-template-columns: 2rem minmax(0, 1fr) 1rem;
    }
    .meta {
      grid-column: 2;
      grid-row: 2;
    }
    .go {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>
