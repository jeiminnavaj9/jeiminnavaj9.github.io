---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

import midnightOnyx from '../assets/dice/midnight_onyx.png';
import darkRuby from '../assets/dice/dark_ruby.png';
import oceanicBlue from '../assets/dice/oceanic_blue.png';
import goldenSun from '../assets/dice/golden_sun.png';
import snowWhite from '../assets/dice/snow_white.png';
import forestGreen from '../assets/dice/forest_green.png';
import scarletBlaze from '../assets/dice/scarlet_blaze.png';
import lemonZest from '../assets/dice/lemon_zest.png';
import crimsonEdge from '../assets/dice/crimson_edge.png';
import palette from '../assets/dice/color_palette.png';

const themes = [
  { name: 'Midnight Onyx', src: midnightOnyx },
  { name: 'Dark Ruby', src: darkRuby },
  { name: 'Oceanic Blue', src: oceanicBlue },
  { name: 'Golden Sun', src: goldenSun },
  { name: 'Snow White', src: snowWhite },
  { name: 'Forest Green', src: forestGreen },
  { name: 'Scarlet Blaze', src: scarletBlaze },
  { name: 'Lemon Zest', src: lemonZest },
  { name: 'Crimson Edge', src: crimsonEdge },
];
---

<BaseLayout
  title="Dice by Phuti Cowrie — Support"
  description="Support and tips for Dice by Phuti Cowrie: rolling dice, themes, and positioning."
  tracking={false}
>
  <PageHeader
    eyebrow="App Support"
    title="Dice by Phuti Cowrie"
    subtitle="Welcome to the support page for Dice by Phuti Cowrie! Here you'll find helpful tips and information to get the most out of your dice-rolling experience."
  />

  <article class="container">
    <div class="prose">
      <h2>How to roll the dice</h2>
      <p>
        Whether you’re missing a die during game night or just prefer the convenience of digital dice,
        <strong>Dice by Phuti Cowrie</strong> has you covered. The app simulates rolling a standard six-sided die, with
        each number (1 through 6) having an equal probability of being rolled, ensuring fair and unbiased results every
        time. Rolling is as simple as a single tap on your screen. You can roll up to five dice at once. Just use the
        slider at the bottom of the screen to choose how many dice to roll.
      </p>

      <h2>Multiple dice themes</h2>
      <p>
        Personalize your dice-rolling experience with a variety of visually appealing themes.
        <strong>Dice by Phuti Cowrie</strong> offers a selection of unique dice themes that can be easily switched to
        match your mood or the ambiance of your game. With themes ranging from classic styles to vibrant colors, there's
        something for everyone.
      </p>
    </div>

    <ul class="gallery">
      {
        themes.map((t) => (
          <li>
            <Image src={t.src} alt="" width={240} height={240} />
            <span>{t.name}</span>
          </li>
        ))
      }
    </ul>

    <div class="prose">
      <h2>Changing themes</h2>
      <p>
        Switching between dice themes is quick and easy. Tap the
        <Image src={palette} alt="sun" width={40} height={40} class="inline-icon" /> icon near the bottom of the
        screen, next to the slider, to bring up the theme options. Scroll through the available themes and select the one
        that best suits your style. Your chosen theme updates instantly, giving your dice a fresh new look.
      </p>

      <h2>Positioning the dice</h2>
      <p>
        The app also includes a drag-and-drop feature, allowing you to customize the positions of your dice on the screen.
        Simply tap and hold any die, then drag it to your desired location. This is especially useful when rolling multiple
        dice, making it easier to read results at a glance.
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .container > .prose:first-child > h2:first-child {
    margin-top: 0;
  }

  .gallery {
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 1rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 0.75rem;
    max-width: 820px;
  }

  .gallery li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    padding: 1.5rem 1rem 1.25rem;
    background: var(--bg-elev);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  .gallery :global(img) {
    width: 72px;
    height: 72px;
    filter: drop-shadow(0 6px 10px rgb(0 0 0 / 0.15));
    transition: transform 0.4s var(--ease);
  }

  .gallery li:hover :global(img) {
    transform: rotate(-8deg) scale(1.05);
  }

  .gallery span {
    font-family: var(--sans);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    text-align: center;
  }

  .prose :global(.inline-icon) {
    display: inline-block;
    width: 1.2em;
    height: 1.2em;
    vertical-align: -0.2em;
  }
</style>
